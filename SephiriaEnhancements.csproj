<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SephiriaEnhancements</AssemblyName>
    <RootNamespace>SephiriaEnhancements</RootNamespace>
    <Version>0.5.0-beta.1</Version>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DeveloperTools Condition="'$(DeveloperTools)' == ''">false</DeveloperTools>
    <SephiriaGameDir Condition="'$(SephiriaGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sephiria</SephiriaGameDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeveloperTools)' == 'true'">
    <DefineConstants>$(DefineConstants);SEPHIRIA_ENHANCEMENTS_DEVTOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="Diagnostics/InventoryReproduction*.cs" Condition="'$(DeveloperTools)' != 'true'" />
  </ItemGroup>

  <Target Name="ValidateDeveloperTools" BeforeTargets="CoreCompile">
    <Error Condition="'$(DeveloperTools)' != 'true' and '$(DeveloperTools)' != 'false'"
           Text="DeveloperTools must be true or false." />
  </Target>

  <ItemGroup>
    <Reference Include="Febucci.TextAnimator.Runtime">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Febucci.TextAnimator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Febucci.TextAnimator.TMP.Runtime">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Febucci.TextAnimator.TMP.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror.Components">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Mirror.Components.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Heathen.Steamworks">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Heathen.Steamworks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(SephiriaGameDir)\Sephiria_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
